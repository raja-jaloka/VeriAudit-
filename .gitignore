*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.pytest_cache/
.coverage
htmlcov/
*.cover
*.pyo

# Node.js, Frontend & Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables, Secrets & API Keys
.env
.env.local
.env.*.local
*.env
secrets.json
credentials.json

# IDEs, Editors & Operating System Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Temporary Task Run Outputs
*.log
logs/
.system_generated/
tmp/
temp/
*.tmp
*.bak
*.swp
